{
  "family": "my-java-angular-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::REPLACE_ACCOUNT_ID:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::REPLACE_ACCOUNT_ID:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "my-java-angular-container",
      "image": "REPLACE_WITH_ECR_URI:latest",
      "portMappings": [ { "containerPort": 8080, "protocol": "tcp" } ],
      "essential": true,
      "environment": [ { "name": "SPRING_PROFILES_ACTIVE", "value": "prod" } ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/my-java-angular",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
